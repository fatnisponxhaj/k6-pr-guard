{
  "name": "p95guard",
  "version": "0.3.1",
  "description": "Catch performance regressions in pull requests: compares load test results with the last good run and posts p95/p99 and error-rate changes as a pass/fail PR comment.",
  "homepage": "https://p95guard.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fatnisponxhaj/p95guard.git"
  },
  "bugs": "https://github.com/fatnisponxhaj/p95guard/issues",
  "type": "module",
  "bin": {
    "p95guard": "src/cli.js"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "test": "node --test test/*.test.js",
    "demo": "node src/cli.js --current test/fixtures/regressed.handle-summary.json --baseline test/fixtures/baseline.handle-summary.json"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "performance-testing",
    "latency",
    "load-testing",
    "performance",
    "github-action",
    "ci"
  ],
  "license": "MIT"
}
